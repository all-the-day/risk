generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  memberships     GroupMember[]
  feedbacks       Feedback[]
  activityRecords ActivityRecord[]
  weeklyScores    WeeklyScore[]
}

model Group {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  disabled   Boolean  @default(false)
  createdAt  DateTime @default(now())

  members      GroupMember[]
  weeklyScores WeeklyScore[]
}

model GroupMember {
  id        String   @id @default(cuid())
  nickname  String
  joinedAt  DateTime @default(now())

  userId  String
  groupId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Feedback {
  id        String   @id @default(cuid())
  type      String // "bug" | "feature"
  content   String
  status    String   @default("pending") // "pending" | "resolved"
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  maxScore    Int // 叶子项分值合计，作为周表分母
  enabled     Boolean  @default(false) // 当前启用的模板
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories ActivityCategory[]
  items      ActivityItem[]
}

model ActivityCategory {
  id         String   @id @default(cuid())
  templateId String
  name       String
  order      Int
  createdAt  DateTime @default(now())

  template ActivityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    ActivityItem[]
}

model ActivityItem {
  id         String   @id @default(cuid())
  templateId String
  categoryId String?
  parentId   String?
  name       String
  fullName   String?
  score      Int // 该项每周满分
  checksPerWeek Int   @default(1) // 一周可打卡次数
  order      Int
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  template ActivityTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category ActivityCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parent   ActivityItem?     @relation("ItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ActivityItem[]    @relation("ItemHierarchy")

  records ActivityRecord[]
}

// 每日打卡记录（打勾式）：一项一天最多一条
model ActivityRecord {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  date      String // YYYY-MM-DD
  checkedAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ActivityItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId, date])
  @@index([userId, date])
}

// 管理员录入的周总分：存在即覆盖自打卡汇总，删除即恢复自动
model WeeklyScore {
  id          String   @id @default(cuid())
  userId      String
  groupId     String
  weekStart   String // YYYY-MM-DD，该周周日
  score       Int
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, weekStart])
  @@index([groupId, weekStart])
}
