generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  nickname  String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  memberships     GroupMember[]
  feedbacks       Feedback[]
  activityRecords ActivityRecord[]
  weeklyScores    WeeklyScore[]
}

model Group {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  disabled   Boolean  @default(false)
  createdAt  DateTime @default(now())

  members      GroupMember[]
  weeklyScores WeeklyScore[]
}

model GroupMember {
  id        String   @id @default(cuid())
  nickname  String
  role      String   @default("member") // "member" | "leader"，团长可见全表
  joinedAt  DateTime @default(now())

  userId  String
  groupId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Feedback {
  id        String   @id @default(cuid())
  type      String // "bug" | "feature"
  content   String
  status    String   @default("pending") // "pending" | "resolved"
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 项目（唯一实体）：规则全部挂在项目上，没有模板 / 分类 / 父子层级
model ActivityItem {
  id         String   @id @default(cuid())
  name       String
  score      Int // 该项每周满分
  checksPerWeek Int   @default(1) // 一周可打卡次数
  allowedWeekdays String? // 打卡日，CSV（0=周日，如 "0" 仅主日）；null = 不限
  scope      String   @default("personal") // "personal" 个人 | "group" 团体
  order      Int
  enabled    Boolean  @default(true)
  deletedAt  DateTime? // 软删除：非空即已删除，历史打卡记录保留
  createdAt  DateTime @default(now())

  records ActivityRecord[]
}

// 每日打卡记录（打勾式）：一项一天最多一条
model ActivityRecord {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  date      String // YYYY-MM-DD
  checkedAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ActivityItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId, date])
  @@index([userId, date])
}

// 管理员录入的周总分：存在即覆盖自打卡汇总，删除即恢复自动
model WeeklyScore {
  id          String   @id @default(cuid())
  userId      String
  groupId     String
  weekStart   String // YYYY-MM-DD，该周周日
  score       Int
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, weekStart])
  @@index([groupId, weekStart])
}
